{
  "type": "panel",
  "i18n": true,
  "items": {
    "_donateImage": {
      "type": "staticImage",
      "src": "spende.png",
      "href": "https://www.paypal.me/SteinchenIO",
      "newLine": true,
      "xs": 4,
      "sm": 2,
      "md": 1,
      "lg": 1,
      "xl": 1
    },
    "_helpLink": {
      "type": "staticLink",
      "button": true,
      "variant": "outlined",
      "icon": "book",
      "href": "https://github.com/SteinchenIO/ioBroker.vis-screensaver/blob/main/README-DE.md",
      "target": "_blank",
      "text": "Instructions (README)",
      "xs": 12,
      "sm": 4,
      "md": 3,
      "lg": 3,
      "xl": 3
    },
    "_headerTiming": {
      "type": "header",
      "text": "Timing",
      "size": 3,
      "newLine": true,
      "xs": 12
    },
    "enabled": {
      "type": "checkbox",
      "label": "Screensaver enabled",
      "newLine": true,
      "xs": 12,
      "sm": 6,
      "md": 4,
      "lg": 4,
      "xl": 4
    },
    "idleSeconds": {
      "type": "number",
      "label": "Time until start (s)",
      "help": "Seconds without touch, click or key press until the slideshow starts",
      "min": 5,
      "max": 86400,
      "step": 5,
      "newLine": true,
      "xs": 12,
      "sm": 6,
      "md": 4,
      "lg": 4,
      "xl": 4
    },
    "slideSeconds": {
      "type": "number",
      "label": "Duration per image (s)",
      "help": "Time from one image change to the next, including the cross-fade",
      "min": 2,
      "max": 3600,
      "newLine": true,
      "xs": 12,
      "sm": 6,
      "md": 4,
      "lg": 4,
      "xl": 4
    },
    "fadeSeconds": {
      "type": "number",
      "label": "Cross-fade duration (s)",
      "help": "0 = hard cut. Must be at least 1 second shorter than the duration per image",
      "min": 0,
      "max": 60,
      "step": 0.5,
      "validator": "Number(data.fadeSeconds) <= Number(data.slideSeconds) - 1",
      "validatorErrorText": "The cross-fade must be at least 1 second shorter than the duration per image",
      "validatorNoSaveOnError": true,
      "newLine": true,
      "xs": 12,
      "sm": 6,
      "md": 4,
      "lg": 4,
      "xl": 4
    },
    "_headerImages": {
      "type": "header",
      "text": "Images",
      "size": 3,
      "newLine": true,
      "xs": 12
    },
    "imageSource": {
      "type": "text",
      "label": "Image folder(s)",
      "help": "Folder in the ioBroker file storage, e.g. vis.0/slideshow. Several folders separated by comma. Upload images under Files in the admin",
      "newLine": true,
      "xs": 12,
      "sm": 12,
      "md": 8,
      "lg": 8,
      "xl": 8
    },
    "rescanMinutes": {
      "type": "number",
      "label": "Rescan folder every (min)",
      "help": "0 = only at adapter start",
      "min": 0,
      "max": 1440,
      "newLine": true,
      "xs": 12,
      "sm": 6,
      "md": 4,
      "lg": 4,
      "xl": 4
    },
    "checkImages": {
      "type": "checkbox",
      "label": "Check image size",
      "help": "Warns in the log about images that are too large for a smooth slideshow",
      "newLine": true,
      "xs": 12,
      "sm": 12,
      "md": 4,
      "lg": 4,
      "xl": 4
    },
    "maxFileKB": {
      "type": "number",
      "label": "Largest recommended file size (KB)",
      "min": 100,
      "max": 50000,
      "step": 100,
      "disabled": "!data.checkImages",
      "xs": 12,
      "sm": 6,
      "md": 4,
      "lg": 4,
      "xl": 4
    },
    "maxMegapixels": {
      "type": "number",
      "label": "Largest recommended resolution (megapixels)",
      "min": 0.5,
      "max": 100,
      "step": 0.5,
      "disabled": "!data.checkImages",
      "xs": 12,
      "sm": 6,
      "md": 4,
      "lg": 4,
      "xl": 4
    },
    "_resizeHint": {
      "type": "staticText",
      "text": "Shrink photos before uploading (1600 x 1000 px, JPEG). The tool runs in your browser, nothing is uploaded. It opens in a new tab. If your browser blocks pop-ups, it opens in this tab instead: allow pop-ups for the admin address, or save your settings first and use the Back button to return. Then upload the result under Files in the admin.",
      "newLine": true,
      "xs": 12,
      "md": 10,
      "lg": 10,
      "xl": 10,
      "sm": 12
    },
    "_resizeLink": {
      "type": "staticImage",
      "src": "foto-werkzeug.png",
      "href": "/files/vis-screensaver.admin/tools/resize.html",
      "xs": 6,
      "sm": 3,
      "md": 2,
      "lg": 2,
      "xl": 2
    },
    "_headerLook": {
      "type": "header",
      "text": "Appearance",
      "size": 3,
      "newLine": true,
      "xs": 12
    },
    "shuffle": {
      "type": "checkbox",
      "label": "Random order",
      "newLine": true,
      "xs": 12,
      "sm": 6,
      "md": 4,
      "lg": 4,
      "xl": 4
    },
    "fit": {
      "type": "select",
      "label": "Image fit",
      "options": [
        {
          "value": "cover",
          "label": "Fill screen (crop)"
        },
        {
          "value": "contain",
          "label": "Show complete image (black bars)"
        }
      ],
      "newLine": true,
      "xs": 12,
      "sm": 6,
      "md": 4,
      "lg": 4,
      "xl": 4
    },
    "kenBurns": {
      "type": "checkbox",
      "label": "Slow zoom",
      "newLine": true,
      "xs": 12,
      "sm": 6,
      "md": 4,
      "lg": 4,
      "xl": 4
    },
    "showClock": {
      "type": "checkbox",
      "label": "Show clock",
      "newLine": true,
      "xs": 12,
      "sm": 6,
      "md": 4,
      "lg": 4,
      "xl": 4
    },
    "_headerDetect": {
      "type": "header",
      "text": "People detection (photo tool, optional)",
      "size": 3,
      "newLine": true,
      "xs": 12
    },
    "_detectText": {
      "type": "staticText",
      "text": "The photo tool can centre the crop on people. This needs about 22 MB, downloaded once from Google and jsDelivr, checked by checksum and kept when the adapter is updated. The photos stay on your computer.",
      "newLine": true,
      "xs": 12,
      "sm": 12,
      "md": 12,
      "lg": 12,
      "xl": 12
    },
    "_detectInstall": {
      "type": "sendTo",
      "command": "installDetection",
      "label": "Install people detection (about 22 MB)",
      "variant": "contained",
      "showProcess": true,
      "timeout": 300000,
      "newLine": true,
      "xs": 12,
      "sm": 6,
      "md": 4,
      "lg": 4,
      "xl": 4
    },
    "_detectStatus": {
      "type": "sendTo",
      "command": "detectionStatus",
      "label": "Check status",
      "variant": "outlined",
      "timeout": 20000,
      "xs": 12,
      "sm": 6,
      "md": 4,
      "lg": 4,
      "xl": 4
    },
    "_headerUse": {
      "type": "header",
      "text": "Usage",
      "size": 3,
      "newLine": true,
      "xs": 12
    },
    "_usage": {
      "type": "staticText",
      "text": "The screensaver is a script that the page loads itself. Steering via the states vis-screensaver.0.control.* – more details in the README.",
      "newLine": true,
      "xs": 12,
      "sm": 12,
      "md": 12,
      "lg": 12,
      "xl": 12
    },
    "_usageCode": {
      "type": "staticText",
      "format": "html",
      "text": {
        "en": "<p style=\"margin:0 0 2px\"><b>Your own page or desktop menu: add before &lt;/body&gt;</b></p><pre style=\"background:rgba(128,128,128,.18);padding:10px 12px;border-radius:6px;font-family:monospace;font-size:13px;line-height:1.5;margin:4px 0 14px;white-space:pre;overflow-x:auto\"><span style=\"color:#d6336c\">&lt;script</span> <span style=\"color:#e8590c\">src</span>=<span style=\"color:#2b9a66\">\"/vis-screensaver/screensaver.js\"</span><span style=\"color:#d6336c\">&gt;&lt;/script&gt;</span></pre><p style=\"margin:0 0 2px\"><b>vis 1: add in the editor under \"Scripts\" (applies to all views)</b></p><pre style=\"background:rgba(128,128,128,.18);padding:10px 12px;border-radius:6px;font-family:monospace;font-size:13px;line-height:1.5;margin:4px 0 14px;white-space:pre;overflow-x:auto\">(<span style=\"color:#9c5bd8\">function</span>(){<span style=\"color:#9c5bd8\">var</span> s=document.<span style=\"color:#1c7ed6\">createElement</span>(<span style=\"color:#2b9a66\">'script'</span>);s.src=<span style=\"color:#2b9a66\">'/vis-screensaver/screensaver.js'</span>;document.head.<span style=\"color:#1c7ed6\">appendChild</span>(s);})();</pre>",
        "de": "<p style=\"margin:0 0 2px\"><b>Eigene Seite oder Desktop-Menü: vor &lt;/body&gt; einfügen</b></p><pre style=\"background:rgba(128,128,128,.18);padding:10px 12px;border-radius:6px;font-family:monospace;font-size:13px;line-height:1.5;margin:4px 0 14px;white-space:pre;overflow-x:auto\"><span style=\"color:#d6336c\">&lt;script</span> <span style=\"color:#e8590c\">src</span>=<span style=\"color:#2b9a66\">\"/vis-screensaver/screensaver.js\"</span><span style=\"color:#d6336c\">&gt;&lt;/script&gt;</span></pre><p style=\"margin:0 0 2px\"><b>vis 1: im Editor unter „Skripte“ eintragen (gilt für alle Ansichten)</b></p><pre style=\"background:rgba(128,128,128,.18);padding:10px 12px;border-radius:6px;font-family:monospace;font-size:13px;line-height:1.5;margin:4px 0 14px;white-space:pre;overflow-x:auto\">(<span style=\"color:#9c5bd8\">function</span>(){<span style=\"color:#9c5bd8\">var</span> s=document.<span style=\"color:#1c7ed6\">createElement</span>(<span style=\"color:#2b9a66\">'script'</span>);s.src=<span style=\"color:#2b9a66\">'/vis-screensaver/screensaver.js'</span>;document.head.<span style=\"color:#1c7ed6\">appendChild</span>(s);})();</pre>",
        "ru": "<p style=\"margin:0 0 2px\"><b>Собственная страница или меню рабочего стола: добавьте перед &lt;/body&gt;</b></p><pre style=\"background:rgba(128,128,128,.18);padding:10px 12px;border-radius:6px;font-family:monospace;font-size:13px;line-height:1.5;margin:4px 0 14px;white-space:pre;overflow-x:auto\"><span style=\"color:#d6336c\">&lt;script</span> <span style=\"color:#e8590c\">src</span>=<span style=\"color:#2b9a66\">\"/vis-screensaver/screensaver.js\"</span><span style=\"color:#d6336c\">&gt;&lt;/script&gt;</span></pre><p style=\"margin:0 0 2px\"><b>vis 1: добавьте в редакторе в разделе «Скрипты» (действует для всех представлений)</b></p><pre style=\"background:rgba(128,128,128,.18);padding:10px 12px;border-radius:6px;font-family:monospace;font-size:13px;line-height:1.5;margin:4px 0 14px;white-space:pre;overflow-x:auto\">(<span style=\"color:#9c5bd8\">function</span>(){<span style=\"color:#9c5bd8\">var</span> s=document.<span style=\"color:#1c7ed6\">createElement</span>(<span style=\"color:#2b9a66\">'script'</span>);s.src=<span style=\"color:#2b9a66\">'/vis-screensaver/screensaver.js'</span>;document.head.<span style=\"color:#1c7ed6\">appendChild</span>(s);})();</pre>",
        "pt": "<p style=\"margin:0 0 2px\"><b>A sua página ou menu de ambiente de trabalho: adicione antes de &lt;/body&gt;</b></p><pre style=\"background:rgba(128,128,128,.18);padding:10px 12px;border-radius:6px;font-family:monospace;font-size:13px;line-height:1.5;margin:4px 0 14px;white-space:pre;overflow-x:auto\"><span style=\"color:#d6336c\">&lt;script</span> <span style=\"color:#e8590c\">src</span>=<span style=\"color:#2b9a66\">\"/vis-screensaver/screensaver.js\"</span><span style=\"color:#d6336c\">&gt;&lt;/script&gt;</span></pre><p style=\"margin:0 0 2px\"><b>vis 1: adicione no editor em «Scripts» (vale para todas as vistas)</b></p><pre style=\"background:rgba(128,128,128,.18);padding:10px 12px;border-radius:6px;font-family:monospace;font-size:13px;line-height:1.5;margin:4px 0 14px;white-space:pre;overflow-x:auto\">(<span style=\"color:#9c5bd8\">function</span>(){<span style=\"color:#9c5bd8\">var</span> s=document.<span style=\"color:#1c7ed6\">createElement</span>(<span style=\"color:#2b9a66\">'script'</span>);s.src=<span style=\"color:#2b9a66\">'/vis-screensaver/screensaver.js'</span>;document.head.<span style=\"color:#1c7ed6\">appendChild</span>(s);})();</pre>",
        "nl": "<p style=\"margin:0 0 2px\"><b>Eigen pagina of bureaubladmenu: toevoegen vóór &lt;/body&gt;</b></p><pre style=\"background:rgba(128,128,128,.18);padding:10px 12px;border-radius:6px;font-family:monospace;font-size:13px;line-height:1.5;margin:4px 0 14px;white-space:pre;overflow-x:auto\"><span style=\"color:#d6336c\">&lt;script</span> <span style=\"color:#e8590c\">src</span>=<span style=\"color:#2b9a66\">\"/vis-screensaver/screensaver.js\"</span><span style=\"color:#d6336c\">&gt;&lt;/script&gt;</span></pre><p style=\"margin:0 0 2px\"><b>vis 1: toevoegen in de editor onder «Scripts» (geldt voor alle weergaven)</b></p><pre style=\"background:rgba(128,128,128,.18);padding:10px 12px;border-radius:6px;font-family:monospace;font-size:13px;line-height:1.5;margin:4px 0 14px;white-space:pre;overflow-x:auto\">(<span style=\"color:#9c5bd8\">function</span>(){<span style=\"color:#9c5bd8\">var</span> s=document.<span style=\"color:#1c7ed6\">createElement</span>(<span style=\"color:#2b9a66\">'script'</span>);s.src=<span style=\"color:#2b9a66\">'/vis-screensaver/screensaver.js'</span>;document.head.<span style=\"color:#1c7ed6\">appendChild</span>(s);})();</pre>",
        "fr": "<p style=\"margin:0 0 2px\"><b>Votre propre page ou menu de bureau : à ajouter avant &lt;/body&gt;</b></p><pre style=\"background:rgba(128,128,128,.18);padding:10px 12px;border-radius:6px;font-family:monospace;font-size:13px;line-height:1.5;margin:4px 0 14px;white-space:pre;overflow-x:auto\"><span style=\"color:#d6336c\">&lt;script</span> <span style=\"color:#e8590c\">src</span>=<span style=\"color:#2b9a66\">\"/vis-screensaver/screensaver.js\"</span><span style=\"color:#d6336c\">&gt;&lt;/script&gt;</span></pre><p style=\"margin:0 0 2px\"><b>vis 1 : à ajouter dans l'éditeur sous « Scripts » (valable pour toutes les vues)</b></p><pre style=\"background:rgba(128,128,128,.18);padding:10px 12px;border-radius:6px;font-family:monospace;font-size:13px;line-height:1.5;margin:4px 0 14px;white-space:pre;overflow-x:auto\">(<span style=\"color:#9c5bd8\">function</span>(){<span style=\"color:#9c5bd8\">var</span> s=document.<span style=\"color:#1c7ed6\">createElement</span>(<span style=\"color:#2b9a66\">'script'</span>);s.src=<span style=\"color:#2b9a66\">'/vis-screensaver/screensaver.js'</span>;document.head.<span style=\"color:#1c7ed6\">appendChild</span>(s);})();</pre>",
        "it": "<p style=\"margin:0 0 2px\"><b>Pagina propria o menu desktop: aggiungere prima di &lt;/body&gt;</b></p><pre style=\"background:rgba(128,128,128,.18);padding:10px 12px;border-radius:6px;font-family:monospace;font-size:13px;line-height:1.5;margin:4px 0 14px;white-space:pre;overflow-x:auto\"><span style=\"color:#d6336c\">&lt;script</span> <span style=\"color:#e8590c\">src</span>=<span style=\"color:#2b9a66\">\"/vis-screensaver/screensaver.js\"</span><span style=\"color:#d6336c\">&gt;&lt;/script&gt;</span></pre><p style=\"margin:0 0 2px\"><b>vis 1: aggiungere nell'editor sotto «Script» (vale per tutte le viste)</b></p><pre style=\"background:rgba(128,128,128,.18);padding:10px 12px;border-radius:6px;font-family:monospace;font-size:13px;line-height:1.5;margin:4px 0 14px;white-space:pre;overflow-x:auto\">(<span style=\"color:#9c5bd8\">function</span>(){<span style=\"color:#9c5bd8\">var</span> s=document.<span style=\"color:#1c7ed6\">createElement</span>(<span style=\"color:#2b9a66\">'script'</span>);s.src=<span style=\"color:#2b9a66\">'/vis-screensaver/screensaver.js'</span>;document.head.<span style=\"color:#1c7ed6\">appendChild</span>(s);})();</pre>",
        "es": "<p style=\"margin:0 0 2px\"><b>Su propia página o menú de escritorio: añadir antes de &lt;/body&gt;</b></p><pre style=\"background:rgba(128,128,128,.18);padding:10px 12px;border-radius:6px;font-family:monospace;font-size:13px;line-height:1.5;margin:4px 0 14px;white-space:pre;overflow-x:auto\"><span style=\"color:#d6336c\">&lt;script</span> <span style=\"color:#e8590c\">src</span>=<span style=\"color:#2b9a66\">\"/vis-screensaver/screensaver.js\"</span><span style=\"color:#d6336c\">&gt;&lt;/script&gt;</span></pre><p style=\"margin:0 0 2px\"><b>vis 1: añadir en el editor en «Scripts» (vale para todas las vistas)</b></p><pre style=\"background:rgba(128,128,128,.18);padding:10px 12px;border-radius:6px;font-family:monospace;font-size:13px;line-height:1.5;margin:4px 0 14px;white-space:pre;overflow-x:auto\">(<span style=\"color:#9c5bd8\">function</span>(){<span style=\"color:#9c5bd8\">var</span> s=document.<span style=\"color:#1c7ed6\">createElement</span>(<span style=\"color:#2b9a66\">'script'</span>);s.src=<span style=\"color:#2b9a66\">'/vis-screensaver/screensaver.js'</span>;document.head.<span style=\"color:#1c7ed6\">appendChild</span>(s);})();</pre>",
        "pl": "<p style=\"margin:0 0 2px\"><b>Własna strona lub menu pulpitu: dodaj przed &lt;/body&gt;</b></p><pre style=\"background:rgba(128,128,128,.18);padding:10px 12px;border-radius:6px;font-family:monospace;font-size:13px;line-height:1.5;margin:4px 0 14px;white-space:pre;overflow-x:auto\"><span style=\"color:#d6336c\">&lt;script</span> <span style=\"color:#e8590c\">src</span>=<span style=\"color:#2b9a66\">\"/vis-screensaver/screensaver.js\"</span><span style=\"color:#d6336c\">&gt;&lt;/script&gt;</span></pre><p style=\"margin:0 0 2px\"><b>vis 1: dodaj w edytorze w sekcji «Skrypty» (dotyczy wszystkich widoków)</b></p><pre style=\"background:rgba(128,128,128,.18);padding:10px 12px;border-radius:6px;font-family:monospace;font-size:13px;line-height:1.5;margin:4px 0 14px;white-space:pre;overflow-x:auto\">(<span style=\"color:#9c5bd8\">function</span>(){<span style=\"color:#9c5bd8\">var</span> s=document.<span style=\"color:#1c7ed6\">createElement</span>(<span style=\"color:#2b9a66\">'script'</span>);s.src=<span style=\"color:#2b9a66\">'/vis-screensaver/screensaver.js'</span>;document.head.<span style=\"color:#1c7ed6\">appendChild</span>(s);})();</pre>",
        "uk": "<p style=\"margin:0 0 2px\"><b>Власна сторінка або меню робочого столу: додайте перед &lt;/body&gt;</b></p><pre style=\"background:rgba(128,128,128,.18);padding:10px 12px;border-radius:6px;font-family:monospace;font-size:13px;line-height:1.5;margin:4px 0 14px;white-space:pre;overflow-x:auto\"><span style=\"color:#d6336c\">&lt;script</span> <span style=\"color:#e8590c\">src</span>=<span style=\"color:#2b9a66\">\"/vis-screensaver/screensaver.js\"</span><span style=\"color:#d6336c\">&gt;&lt;/script&gt;</span></pre><p style=\"margin:0 0 2px\"><b>vis 1: додайте в редакторі в розділі «Скрипти» (діє для всіх подань)</b></p><pre style=\"background:rgba(128,128,128,.18);padding:10px 12px;border-radius:6px;font-family:monospace;font-size:13px;line-height:1.5;margin:4px 0 14px;white-space:pre;overflow-x:auto\">(<span style=\"color:#9c5bd8\">function</span>(){<span style=\"color:#9c5bd8\">var</span> s=document.<span style=\"color:#1c7ed6\">createElement</span>(<span style=\"color:#2b9a66\">'script'</span>);s.src=<span style=\"color:#2b9a66\">'/vis-screensaver/screensaver.js'</span>;document.head.<span style=\"color:#1c7ed6\">appendChild</span>(s);})();</pre>",
        "zh-cn": "<p style=\"margin:0 0 2px\"><b>自己的页面或桌面菜单：添加在 &lt;/body&gt; 之前</b></p><pre style=\"background:rgba(128,128,128,.18);padding:10px 12px;border-radius:6px;font-family:monospace;font-size:13px;line-height:1.5;margin:4px 0 14px;white-space:pre;overflow-x:auto\"><span style=\"color:#d6336c\">&lt;script</span> <span style=\"color:#e8590c\">src</span>=<span style=\"color:#2b9a66\">\"/vis-screensaver/screensaver.js\"</span><span style=\"color:#d6336c\">&gt;&lt;/script&gt;</span></pre><p style=\"margin:0 0 2px\"><b>vis 1：在编辑器的“脚本”中添加（适用于所有视图）</b></p><pre style=\"background:rgba(128,128,128,.18);padding:10px 12px;border-radius:6px;font-family:monospace;font-size:13px;line-height:1.5;margin:4px 0 14px;white-space:pre;overflow-x:auto\">(<span style=\"color:#9c5bd8\">function</span>(){<span style=\"color:#9c5bd8\">var</span> s=document.<span style=\"color:#1c7ed6\">createElement</span>(<span style=\"color:#2b9a66\">'script'</span>);s.src=<span style=\"color:#2b9a66\">'/vis-screensaver/screensaver.js'</span>;document.head.<span style=\"color:#1c7ed6\">appendChild</span>(s);})();</pre>"
      },
      "newLine": true,
      "xs": 12,
      "sm": 12,
      "md": 12,
      "lg": 12,
      "xl": 12
    }
  }
}
