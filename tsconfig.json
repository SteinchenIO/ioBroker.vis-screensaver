{
    "extends": "@tsconfig/node22/tsconfig.json",
    "compilerOptions": {
        "allowJs": true,
        "checkJs": false,
        "noEmit": true,
        "noImplicitAny": false,
        "strict": false,
        "skipLibCheck": true,
        "resolveJsonModule": true
    },
    "include": ["main.js", "lib/**/*.js", "eslint.config.mjs"],
    "exclude": ["node_modules/**", "www/**", "widgets/**", "admin/**", "examples/**", "test/**"]
}
